# ==================== LLM配置 ====================

OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1
OPENAI_API_KEY=

LLM_MAIN=Qwen/Qwen3.5-35B-A3B
LLM_JUDGE=Qwen/Qwen3.5-35B-A3B
LLM_TIMEOUT=60


# ==================== 商品向量召回 ====================

ANN_INDEX_PATH=./data/item_index.faiss
ANN_AUTO_BUILD_DEMO=true

# local 无需额外服务，适合本地联调；生产环境改为 http。
TOWER_BACKEND=local
TOWER_EMBEDDING_DIM=256

# TOWER_BACKEND=http 时必须配置以下三个端点。
TOWER_USER_ENDPOINT=http://localhost:8081/encode/user
TOWER_QUERY_ENDPOINT=http://localhost:8081/encode/query
TOWER_ITEM_ENDPOINT=http://localhost:8081/encode/item

# 可选；仅在品类知识库需要精排时使用。
RERANKER_ENDPOINT=http://localhost:8082/rerank


# ==================== RAG 商品知识库 ====================

OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASS=admin
CATEGORY_KB_REQUIRED=false


# 当前版本的长期记忆为单进程内存实现；Redis 和平台开放
# API 尚未接入，因此模板中不再声明不会生效的配置项。


# ==================== Web搜索 ====================

TAVILY_API_KEY=


# ==================== Agent 运行限制 ====================

AGENT_LOOP_MAX_ITERATIONS=30
AGENT_TIMEOUT_SEC=300
FORK_MAX_DEPTH=2
SUB_AGENT_TIMEOUT_SEC=90


# ==================== AGUI / WebSocket ====================

WS_EVENT_BUFFER_SIZE=200
