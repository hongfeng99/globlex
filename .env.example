# ==================== LLM配置 ====================

OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1
OPENAI_API_KEY=

LLM_MAIN=Qwen/Qwen3.5-35B-A3B
LLM_JUDGE=Qwen/Qwen3.5-35B-A3B
LLM_TIMEOUT=60


# ==================== 三塔向量召回 ====================

ANN_BACKEND=faiss
ANN_INDEX_PATH=./data/item_index.faiss

TOWER_USER_ENDPOINT=http://localhost:8081/encode/user
TOWER_QUERY_ENDPOINT=http://localhost:8081/encode/query
TOWER_ITEM_ENDPOINT=http://localhost:8081/encode/item


# ==================== 长期记忆Store ====================

STORE_BACKEND=redis
STORE_REDIS_URL=redis://localhost:6379/2


# ==================== 跨平台商品检索 ====================

AMAZON_API_KEY=
SHOPEE_API_KEY=
ALIEXPRESS_API_KEY=
EBAY_API_KEY=


# ==================== Web搜索 ====================

TAVILY_API_KEY=


# ==================== 上下文压缩 ====================

COMPRESS_KEEP_RECENT=3
COMPRESS_MAX_TOKENS=12000


# ==================== AGUI / WebSocket ====================

WS_PING_INTERVAL=20


# ==================== 评测与轨迹 ====================

RUBRIC_HIGH_SCORE=70
TRACE_LOG_DIR=./data/traces

