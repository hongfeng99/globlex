# ==================== LLM配置 ====================

OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1
OPENAI_API_KEY=

LLM_MAIN=Qwen/Qwen3.5-35B-A3B
LLM_JUDGE=Qwen/Qwen3.5-35B-A3B
LLM_TIMEOUT=60
# Qwen 思考模式不支持 required/指定工具 tool_choice；阶段状态机需关闭。
LLM_ENABLE_THINKING=false
LLM_CLIENT_MAX_RETRIES=2
LLM_MIDDLEWARE_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF_SEC=2
LLM_MAX_CONCURRENCY=2


# ==================== 商品向量召回 ====================

ANN_INDEX_PATH=./data/item_index.faiss
# 索引缺失时从 data/offline_catalog.json 自动构建。
ANN_AUTO_BUILD_DEMO=true

# 默认三塔共享同一个多语言语义模型，无需单独训练 Query 塔。
# 首次运行会下载模型；完全离线或低配环境可改成 hash。
TOWER_BACKEND=sentence_transformers
TOWER_MODEL_NAME=intfloat/multilingual-e5-small
TOWER_MODEL_REVISION=
TOWER_DEVICE=cpu
TOWER_LOCAL_FILES_ONLY=false
TOWER_BATCH_SIZE=32
TOWER_QUERY_PREFIX="query: "
TOWER_ITEM_PREFIX="passage: "
TOWER_USER_PREFIX="query: "
TOWER_QUERY_WEIGHT=0.75
TOWER_USER_WEIGHT=0.25

# 仅 TOWER_BACKEND=hash/local 时使用。
TOWER_EMBEDDING_DIM=256

# TOWER_BACKEND=http 时必须配置以下三个端点；三端应共享向量空间。
TOWER_USER_ENDPOINT=http://localhost:8081/encode/user
TOWER_QUERY_ENDPOINT=http://localhost:8081/encode/query
TOWER_ITEM_ENDPOINT=http://localhost:8081/encode/item

# 可选；仅在品类知识库需要精排时使用。
RERANKER_ENDPOINT=http://localhost:8082/rerank


# ==================== RAG 商品知识库 ====================

OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASS=admin
CATEGORY_KB_ANALYZER=standard
CATEGORY_KB_REQUIRED=false
# 低于此置信度或缺少品类结构时，自动回退 WebSearch。
CATEGORY_INSIGHT_MIN_CONFIDENCE=0.45


# 当前版本的长期记忆为单进程内存实现；Redis 和平台开放
# API 尚未接入，因此模板中不再声明不会生效的配置项。


# ==================== Web搜索 ====================

TAVILY_API_KEY=


# ==================== Agent 运行限制 ====================

AGENT_LOOP_MAX_ITERATIONS=30
AGENT_TIMEOUT_SEC=300
FORK_MAX_DEPTH=2
SUB_AGENT_TIMEOUT_SEC=180
SUB_AGENT_LOOP_MAX_ITERATIONS=30


# ==================== AGUI / WebSocket ====================

WS_EVENT_BUFFER_SIZE=200
